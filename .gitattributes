# Normalise line endings in the repository to LF regardless of any individual
# contributor's core.autocrlf setting. Moodle's plugin checker and PHPCS both
# reject CRLF, and this plugin's CI (and any real Moodle install) runs on Linux.
* text=auto eol=lf

*.php text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.js text eol=lf
*.css text eol=lf

# Binary files — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
